# =============================================================================
# ConnectWiseManageAPI - .gitignore
# =============================================================================
# Comprehensive ignore patterns optimized for PowerShell modules
# Based on best practices for PowerShell development

# =============================================================================
# Project-Specific
# =============================================================================
Scratch\.ps1
BACKUP_*/
*.bak

# =============================================================================
# Operating Systems
# =============================================================================

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
*.stackdump
[Dd]esktop.ini
$RECYCLE.BIN/
*.cab
*.msi
*.msix
*.msm
*.msp
*.lnk

# macOS
.DS_Store
.AppleDouble
.LSOverride
Icon
._*
.DocumentRevisions-V100
.fseventsd
.Spotlight-V100
.TemporaryItems
.Trashes
.VolumeIcon.icns
.com.apple.timemachine.donotpresent

# Linux
*~
.fuse_hidden*
.directory
.Trash-*
.nfs*

