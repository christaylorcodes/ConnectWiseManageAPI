# =============================================================================
.travis.yml.bak
.circleci/local.yml

# =============================================================================
# Other Development Tools
# =============================================================================

# Node.js (if using for tooling)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Python (if using for tooling)
__pycache__/
*.py[cod]
venv/
.venv/

# Personal blog drafts (kept locally, not part of the module repo)
BLOG/
# Internal planning notes (kept locally)
MAP.md
TODO.md

# Live test connection settings (copy Tests/live.example.ps1)
Tests/live.local.ps1
